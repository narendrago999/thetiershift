{
  "name": "TierShift AI Data Factory",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/ai-data-factory/backend/.venv/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": [
          "ai-data-factory/backend/tests"
        ]
      }
    }
  },
  "postCreateCommand": "python -m venv ai-data-factory/backend/.venv && ai-data-factory/backend/.venv/bin/python -m pip install --upgrade pip && ai-data-factory/backend/.venv/bin/pip install -r ai-data-factory/backend/requirements.txt",
  "forwardPorts": [8000, 5500],
  "portsAttributes": {
    "8000": {
      "label": "TierShift API",
      "onAutoForward": "notify"
    },
    "5500": {
      "label": "TierShift frontend",
      "onAutoForward": "openBrowser"
    }
  }
}
