APP_ENV=development
APP_BASE_URL=http://localhost:5500
API_BASE_URL=http://localhost:8000
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DB?sslmode=require
CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_YOUR_CLERK_PUBLISHABLE_KEY
CLERK_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_CLERK_SECRET_KEY
CLERK_ISSUER=https://YOUR_CLERK_ISSUER
CLERK_JWKS_URL=https://YOUR_CLERK_ISSUER/.well-known/jwks.json
CORS_ORIGINS=http://localhost:5500,https://thetiershift.com
INTERNAL_EMAIL_DOMAINS=thetiershift.com
INVITATION_TOKEN_TTL_HOURS=168
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# LLM placeholders only — replace with real provider values before use.
# No outbound LLM requests are made with these example values.
LLM_BASE_URL=https://api.example.invalid/v1
LLM_API_KEY=YOUR_LLM_API_KEY
